---
import data from "./data.json";
import logoUrl from "../../design-logo.svg?url";

const { students } = data;
const getStudentSlug = (name) =>
  name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>DESN Seniors</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: "Oswald", sans-serif;
        font-size: 14px;
        background: #fff;
        color: #111;
        padding: clamp(5.4rem, 9.5vw, 7.6rem) 2rem 2rem;
        text-transform: uppercase;
      }

      .site-logo {
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 10;
        display: block;
        width: clamp(2.75rem, 6vw, 4.5rem);
        line-height: 0;
      }

      .site-logo img {
        width: 100%;
        height: auto;
        display: block;
      }

      h1 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 2rem;
        letter-spacing: 0.05em;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem 1rem;
      }

      .card {
        border: 0;
        padding: 1.5rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        text-align: center;
      }

      .profile-button {
        display: block;
        border-radius: 50%;
        transition: opacity 160ms ease, transform 160ms ease;
      }

      .profile-button:hover,
      .profile-button:focus-visible {
        opacity: 0.82;
        transform: scale(1.03);
      }

      .profile-button:focus-visible {
        outline: 2px solid #111;
        outline-offset: 0.35rem;
      }

      .profile-button img {
        width: clamp(5.5rem, 18vw, 14rem);
        max-width: 100%;
        aspect-ratio: 1;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        background: #f0f0f0;
      }

      .card-name {
        font-weight: 600;
        font-size: clamp(1.1rem, 2.4vw, 1.8rem);
        line-height: 1.05;
      }

    </style>
  </head>
  <body>
    <a class="site-logo" href="/" aria-label="DESN Seniors home">
      <img src={logoUrl} alt="" />
    </a>

    <h1>Seniors &rsquo;26</h1>
    <div class="grid">

      {students.map((student) => (
        <div class="card">
          <a
            class="profile-button"
            href={`/students/${getStudentSlug(student.name)}/`}
            aria-label={`View ${student.name}'s profile`}
          >
            <img src={student.image} alt={student.name} loading="lazy" />
          </a>
          <div class="card-name">
            {student.name}
          </div>
        </div>
      ))}

    </div>
  </body>
</html>
