---
import data from "./data.json";
import logoUrl from "../../design-logo.svg?url";
import skyBackgroundUrl from "../../background-sky.png?url";

const { students } = data;
const getStudentSlug = (name) =>
  name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
---

<html lang="en" style={`--sky-background: url(${skyBackgroundUrl});`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>SENIORS 2026</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html {
        min-height: 100%;
        background: #87bce2 var(--sky-background) center top / cover no-repeat fixed;
      }

      body {
        --brand-red: #7C0902;
        --site-nav-height: clamp(5.4rem, 9.5vw, 7.6rem);
        --profile-row-gap: clamp(5.5rem, 9vw, 8rem);
        --profile-top-gap: clamp(7rem, 11vw, 10rem);
        min-height: 100vh;
        font-family: "Oswald", sans-serif;
        font-size: 14px;
        background: transparent;
        color: var(--brand-red);
        padding: 0 2rem 2rem;
        text-transform: uppercase;
      }

      .site-nav {
        position: relative;
        z-index: 10;
        height: var(--site-nav-height);
        margin-right: -2rem;
        margin-left: -2rem;
        background: transparent;
      }

      .site-logo {
        position: relative;
        top: 1rem;
        left: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--brand-red);
        font-weight: 600;
        font-size: clamp(1.25rem, 2.8vw, 2.15rem);
        line-height: 1;
      }

      .site-logo img {
        width: clamp(4rem, 8vw, 6.5rem);
        height: auto;
        display: block;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--profile-row-gap) 1rem;
        margin-top: var(--profile-top-gap);
      }

      .card {
        border: 0;
        padding: 0 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        text-align: center;
      }

      .profile-button {
        display: block;
        border-radius: 50%;
        transition: opacity 160ms ease, transform 160ms ease;
      }

      .profile-button:hover,
      .profile-button:focus-visible {
        opacity: 0.82;
        transform: scale(1.03);
      }

      .profile-button:focus-visible {
        outline: 2px solid var(--brand-red);
        outline-offset: 0.35rem;
      }

      .profile-button img {
        width: clamp(5.5rem, 18vw, 14rem);
        max-width: 100%;
        aspect-ratio: 1;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        background: #f0f0f0;
      }

      .card-name {
        font-weight: 600;
        font-size: clamp(1.1rem, 2.4vw, 1.8rem);
        line-height: 1.05;
      }

    </style>
  </head>
  <body>
    <nav class="site-nav" aria-label="Site">
      <div class="site-logo" aria-label="SENIORS 2026">
        <img src={logoUrl} alt="" />
        <span>SENIORS 2026</span>
      </div>
    </nav>

    <div class="grid">

      {students.map((student) => (
        <div class="card">
          <a
            class="profile-button"
            href={`/students/${getStudentSlug(student.name)}/`}
            aria-label={`View ${student.name}'s profile`}
          >
            <img src={student.image} alt={student.name} loading="lazy" />
          </a>
          <div class="card-name">
            {student.name}
          </div>
        </div>
      ))}

    </div>
  </body>
</html>
