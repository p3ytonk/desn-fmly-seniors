---
import data from "./data.json";
const { students } = data;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>DESN Seniors</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: sans-serif;
        font-size: 14px;
        background: #fff;
        color: #111;
        padding: 2rem;
      }

      h1 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 2rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1px;
        border: 1px solid #e0e0e0;
      }

      .card {
        border: 0;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        border-right: 1px solid #e0e0e0;
        border-bottom: 1px solid #e0e0e0;
      }

      .card img {
        width: 100%;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        display: block;
        background: #f0f0f0;
      }

      .card-name {
        font-weight: 600;
        font-size: 0.9rem;
      }

      .card-emoji {
        font-size: 1.1rem;
      }

      .card-links {
        display: flex;
        gap: 0.75rem;
        margin-top: auto;
      }

      .card-links a {
        font-size: 0.75rem;
        color: #555;
        text-decoration: none;
        border-bottom: 1px solid currentColor;
        line-height: 1;
      }

      .card-links a:hover {
        color: #000;
      }
    </style>
  </head>
  <body>
    <h1>Seniors &rsquo;26</h1>
    <div class="grid">

      {students.map((student) => (
        <div class="card">
          <img src={student.image} alt={student.name} loading="lazy" />
          <div class="card-name">
            <span class="card-emoji">{student.favorite_emoji }</span> {student.name}
          </div>
          <div class="card-links">
            <a href={student.github_permalink} target="_blank" rel="noopener">Portfolio</a>
            <a href={student.github_profile} target="_blank" rel="noopener">GitHub</a>
            <a href={student.codepen_profile} target="_blank" rel="noopener">CodePen</a>
          </div>
        </div>
      ))}

    </div>
  </body>
</html>
